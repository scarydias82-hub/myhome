# Optional. Defaults to "myhome-demo-bot/1.0 (concept demo; contact hello@myhome.com)".
USER_AGENT=

# Minimum delay between requests in ms. Defaults to 2500. Do not lower below 2000.
REQUEST_DELAY_MS=

# Required for `pnpm ingest`. Use the same values as apps/web/.env.local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for `pnpm embed` (M2 — product image embeddings).
# Same value as FAL_KEY in apps/web/.env.local.
FAL_KEY=
