{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/cron/featured-products",
      "schedule": "0 16 * * 0"
    }
  ]
}
