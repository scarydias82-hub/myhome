# Public — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
NEXT_PUBLIC_POSTHOG_KEY=phc_<your-key>
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sign-ups: 'false' (default) keeps /signup in the closed-beta state.
# Flip to 'true' AND re-enable sign-ups in Supabase Auth → Providers
# to reopen public registration. See docs/OVERVIEW.md §2.5 + §7.3.
NEXT_PUBLIC_SIGNUPS_OPEN=false

# Server-only — never expose
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Sentry (optional in dev; required in prod)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
